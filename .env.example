# ============================================================================
# Himalayan Magic Adventure — environment variables
# Copy this file to `.env` for local development (never commit `.env`).
# In production, add the same variables in Vercel → Project → Settings →
# Environment Variables, then redeploy.
# ============================================================================

# ---- Admin sign-in (required for /admin) -----------------------------------
ADMIN_EMAIL=you@example.com
# Generate with:  npm run admin:password
ADMIN_PASSWORD_HASH=scrypt$replace$me
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Optional: hours before you are signed out (default 12)
# ADMIN_SESSION_HOURS=12

# Local development only (ignored in production): a plain password instead of a hash
# ADMIN_PASSWORD=change-me

# ---- Database: Supabase (required in production) ----------------------------
# Without these, content and bookings are stored in local files under data/
# (fine on your computer; read-only on Vercel).
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The *service_role* key. Server-side only — never put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for uploaded images (created by supabase/schema.sql)
SUPABASE_BUCKET=media

# ---- Booking email alerts (optional) ----------------------------------------
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Himalayan Magic Adventure <bookings@example.com>"
# Where new-booking alerts are sent (comma-separate several addresses)
BOOKING_NOTIFY_TO=
# Also send the customer a short "we received your request" email
BOOKING_CUSTOMER_COPY=false

# ---- Site ------------------------------------------------------------------
SITE_URL=https://himalayanmagic.com
# PORT=8000
