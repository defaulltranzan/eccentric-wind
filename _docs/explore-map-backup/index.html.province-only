        :root {
            --background: #1b1e22;
            --foreground: #f3f4f6;
            --card: #22252a;
            --border: #2e3239;
            --accent: #f06225;
            --accent-hover: #d04e1b;
            --muted: #272b32;
            --muted-foreground: #9ca3af;
        }
        
        .light-mode {
            --background: #f9fafb;
            --foreground: #111827;
            --card: #ffffff;
            --border: #e5e7eb;
            --accent: #e04f1a;
            --accent-hover: #c23e11;
            --muted: #f3f4f6;
            --muted-foreground: #4b5563;
        }

        body {
            background-color: var(--background);
            color: var(--foreground);
            font-family: 'IBM Plex Mono', monospace;
            line-height: 1.6;
            /* NB: do not transition background-color — Chrome fails to re-resolve
               a var()-derived value mid-transition, which leaves the body stuck
               on the old theme's background. Colour transition is safe. */
            transition: none; /* theme switch is instant — see tw-input.css note */
        }
        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--background);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--accent);
            border-radius: 3px;
        }
        /* Animation: Drift */
        @keyframes drift {
            0% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
            100% { transform: translateY(0); }
        }
        .animate-drift {
            animation: drift 8s ease-in-out infinite;
        }
        /* Announcement Bar Scroll Behavior */
        .announcement-bar {
            transition: transform 0.3s ease-in-out;
        }
        .announcement-hidden {
            transform: translateY(-100%);
        }
        /* Editing Highlights */
        .editable-active {
            outline: 1px dashed var(--accent) !important;
            outline-offset: 4px;
            cursor: text;
        }
        .editable-active:hover {
            background-color: rgba(240, 98, 37, 0.05);
        }

        /* Flagship Expeditions — single-line scroller */
        .hme-hscroll { scrollbar-width: thin; scrollbar-color: var(--accent) transparent; scroll-behavior: smooth; }
        .hme-hscroll::-webkit-scrollbar { height: 4px; }
        .hme-hscroll::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
        .hme-hscroll::-webkit-scrollbar-thumb { background: rgba(240,98,37,0.5); border-radius: 2px; }
        .hme-hscroll::-webkit-scrollbar-thumb:hover { background: var(--accent); }
        .hme-flag-nav {
            position: absolute; top: 42%; z-index: 20; height: 2.6rem; width: 2.6rem;
            display: none; align-items: center; justify-content: center;
            border: 1px solid var(--border); background: rgba(16,18,21,0.92); color: var(--foreground);
            font-size: 20px; line-height: 1; cursor: pointer; backdrop-filter: blur(6px);
            transition: border-color .2s, color .2s, transform .18s, opacity .25s;
        }
        .hme-flag-nav:hover { border-color: var(--accent); color: var(--accent); }
        .hme-flag-nav:active { transform: scale(.92); }
        .hme-flag-nav[disabled] { opacity: .3; pointer-events: none; }
        @media (min-width: 1024px) { .hme-flag-nav { display: flex; } }
        @media (max-width: 767px) { .hme-flag-extra { display: none !important; } }
        @media (prefers-reduced-motion: reduce) { .hme-hscroll { scroll-behavior: auto; } }

        /* Section 02 — route-type switch */
        .hme-flag-tab {
            padding: .62rem .9rem; border: 1px solid var(--border);
            background: rgba(16,18,21,.5); color: var(--muted-foreground);
            cursor: pointer; white-space: nowrap;
            transition: color .2s, border-color .2s, background .2s;
        }
        .hme-flag-tab:hover { border-color: var(--accent); color: var(--foreground); }
        .hme-flag-tab[aria-selected="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
        .hme-flag-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        /* trailing "explore all" tile — same footprint as a face card */
        .hme-flag-more {
            border: 1px dashed var(--border); background: rgba(16,18,21,.35);
            transition: border-color .25s, background .25s, transform .25s;
        }
        .hme-flag-more:hover { border-color: var(--accent); background: rgba(240,98,37,.06); transform: translateY(-4px); }
        /* .hme-navlink / .hme-cta header-nav hover styles now live in build/tw-input.css (shared by all pages) */
