    <script>
    /* Homepage Compare-Treks preview table (04) */
    (function () {
      var box = document.getElementById('compare-home-table');
      var T = window.TREKS || {};
      if (!box || !Object.keys(T).length) return;
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
      var firstInt = function (s) { var m = String(s || '').replace(/,/g, '').match(/\d+/); return m ? +m[0] : null; };
      var slugs = ['everest-base-camp', 'annapurna-circuit', 'langtang-valley'].filter(function (s) { return T[s]; });
      var vm = slugs.map(function (s) {
        var t = T[s], st = t.stats || {};
        var pr = (t.cost && t.cost.tiers && t.cost.tiers[0] && t.cost.tiers[0].rangeUSD) || '';
        var pm = pr.match(/\$[\d,]+/); var pv = pm ? +pm[0].replace(/[$,]/g, '') : null;
        var dm = String(st.duration || '').match(/(\d+)(?:\s*[–—-]\s*(\d+))?\s*days?/i);
        var accNote = (t.accommodationNote || '').toLowerCase();
        return {
          slug: s, name: t.name.replace(/ Trek$/, ''), region: t.region || '',
          dur: dm ? (dm[2] ? dm[1] + '–' + dm[2] + 'd' : dm[1] + 'd') : (st.duration || '').split('(')[0].trim(),
          alt: (st.maxAltitude || '—').replace(/^[≈~\s]+/, '').split('(')[0].trim(),
          diff: st.difficulty || '—', season: st.bestSeason || '—',
          cost: pv == null ? '—' : pv < 1200 ? '$' : pv < 2200 ? '$$' : '$$$',
          teahouse: !/camping/.test(accNote) || /tea ?house/.test(accNote)
        };
      });
      var rows = [
        ['Duration', function (m) { return esc(m.dur); }],
        ['Max altitude', function (m) { return '<span class="text-accent">' + esc(m.alt) + '</span>'; }],
        ['Difficulty', function (m) { return esc(m.diff); }],
        ['Best season', function (m) { return esc(m.season); }],
        ['Cost', function (m) { return '<span class="text-white">' + esc(m.cost) + '</span>'; }],
        ['Tea houses', function (m) { return m.teahouse ? '<span class="text-accent">✓</span>' : '✗'; }]
      ];
      box.innerHTML = '<table class="w-full border-collapse font-mono text-xs bg-[#16181b] border border-border min-w-[520px]">' +
        '<thead><tr><th class="text-left p-4 border-b border-border"></th>' +
        vm.map(function (m) { return '<th class="text-left p-4 border-b border-l border-border"><a href="/treks/' + esc(m.slug) + '" class="font-heading text-lg md:text-xl uppercase text-white hover:text-accent transition-colors leading-tight block">' + esc(m.name) + '</a><span class="block text-[9px] uppercase tracking-widest text-muted-foreground mt-1">' + esc(m.region) + '</span></th>'; }).join('') + '</tr></thead><tbody>' +
        rows.map(function (r, i) {
          return '<tr class="' + (i % 2 ? 'bg-[#1b1e22]' : '') + '"><td class="p-4 text-[9px] uppercase tracking-[0.2em] text-muted-foreground border-b border-border/50">' + esc(r[0]) + '</td>' +
            vm.map(function (m) { return '<td class="p-4 text-foreground/90 border-b border-l border-border/50">' + r[1](m) + '</td>'; }).join('') + '</tr>';
        }).join('') + '</tbody></table>';
    })();
    </script>
