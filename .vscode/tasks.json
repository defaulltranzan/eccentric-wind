{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Himalayan Magic Adventure (8000)",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*HIMALAYAN MAGIC ADVENTURE.*",
          "endsPattern": ".*Live Address.*"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
